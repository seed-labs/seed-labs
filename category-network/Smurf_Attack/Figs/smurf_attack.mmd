%%{init: {"flowchart": {"htmlLabels": false}, "themeVariables": {"fontSize": "28px", "edgeLabelBackground": "transparent"}}}%%
flowchart LR
    subgraph whole["Smurf Attack Packet Flow"]
        direction LR
        attacker["Attacker<br/>AS-150<br/>10.150.0.71"]
        victim["Victim<br/>AS-151<br/>10.151.0.71"]

        subgraph amp["Amplifier LAN<br/>AS-152<br/>10.152.0.0/24"]
            direction LR
            router["Router<br/>broadcast<br/>forwarding on<br/>10.152.0.254"]
            broadcast["Broadcast<br/>address<br/>10.152.0.255"]
            h1["Host 0<br/>10.152.0.71"]
            h2["Host 1<br/>10.152.0.72"]
            h3["Host 2<br/>10.152.0.73"]
            hn["More hosts<br/>..."]
        end

        attacker -- "1. Spoofed<br/>ICMP request<br/>src: victim<br/>dst: broadcast" --> router
        router -- "2. Forward<br/>as broadcast" --> broadcast
        broadcast --> h1
        broadcast --> h2
        broadcast --> h3
        broadcast --> hn

        h1 -- "3. Reply" --> victim
        h2 -- "3. Reply" --> victim
        h3 -- "3. Reply" --> victim
        hn -- "3. Replies" --> victim
    end

    style whole fill:transparent,stroke:#222,stroke-width:2px
    style amp fill:transparent,stroke:#8a8a20,stroke-width:1.5px
    classDef attacker fill:#f9d6d5,stroke:#9d2f2f,stroke-width:2px,color:#111;
    classDef victim fill:#d9ebff,stroke:#2f5f9d,stroke-width:2px,color:#111;
    classDef router fill:#fff0c2,stroke:#8a6d1d,stroke-width:2px,color:#111;
    classDef host fill:#ddf4dd,stroke:#387a38,stroke-width:1.5px,color:#111;
    classDef broadcast fill:#f5f5f5,stroke:#555,stroke-dasharray:5 5,color:#111;

    class attacker attacker;
    class victim victim;
    class router router;
    class h1,h2,h3,hn host;
    class broadcast broadcast;
